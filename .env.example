# ---- ClearWay core ----
CLEARWAY_DATA_DIR=./data
CLEARWAY_DEMO_MODE=true            # seeds two demo households + exposes demo tokens at /api/demo/households
CLEARWAY_RETENTION_DAYS=14         # evidence frames older than this are purged (ledger keeps hashes)
CLEARWAY_CLOSE_AFTER_CLEAR=1       # consecutive clear observations to close a DEMO incident
CLEARWAY_LIVE_CLOSE_AFTER_CLEAR=2  # consecutive independent server-captured clear observations to close a LIVE incident
CLEARWAY_MEDIA_URL_TTL_S=900       # lifetime of signed media links
CLEARWAY_MAX_UPLOAD_MB=25
CLEARWAY_MAX_VIDEO_SECONDS=60
CLEARWAY_MAX_IMAGE_PIXELS=16777216
CLEARWAY_LIVE_MIN_CLEAR_SEPARATION_S=60   # live closure: clear frames must come from separate capture sessions this far apart
CLEARWAY_EVENT_MAX_ATTEMPTS=3              # attempts per claim
CLEARWAY_EVENT_MAX_TOTAL_ATTEMPTS=9        # then the event is marked DEAD
CLEARWAY_EVENT_LEASE_S=300
CLEARWAY_EVENT_RETRY_AFTER_S=120
CLEARWAY_EVENT_SWEEP_INTERVAL_S=30

# ---- Live household (the ONLY household that can use the Ring camera; never listed by demo endpoints) ----
# Use long random values, e.g.  python -c "import secrets;print(secrets.token_urlsafe(32))"
CLEARWAY_LIVE_HOUSEHOLD_TOKEN=
CLEARWAY_LIVE_APPROVER_TOKEN=
CLEARWAY_LIVE_HELPER_TOKEN=
CLEARWAY_TOKEN_KEY=                # Fernet key for encrypting rotated Ring tokens; auto-generated in data dir if empty

# ---- Ring Partner API (server-side only; never exposed to the browser) ----
RING_API_BASE=https://api.amazonvision.com
RING_OAUTH_URL=https://oauth.ring.com/oauth/token
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_DEVICE_ID=
RING_COMPONENT_ID=                 # multi-camera devices only
RING_HARDWARE_ID=                  # UUID; derived deterministically if empty
RING_USER_AGENT=ClearWayAccessGraph/2.0
RING_WEBHOOK_SECRET=               # HMAC signing key from the Ring developer console
RING_SOURCE_LABEL=RING_PLAYGROUND  # or RING_LIVE for production devices
RING_MAX_SESSION_S=25              # battery devices end WHEP sessions at ~30 s, line-powered ~60 s

# ---- Custom event simulator (separate key; events are labelled CUSTOM_EVENT_SIMULATOR) ----
SIMULATOR_WEBHOOK_SECRET=change-me-local-simulator-secret

# ---- AWS (optional Stage 3 escalation) ----
AWS_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0   # verify the exact model/inference-profile id in your Bedrock console
